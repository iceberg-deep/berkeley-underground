# ─────────────────────────────────────────────────────────────────────────────
# Box 1 build parameters.  Sourced by every build/*.sh script and by run.sh.
# Edit here to retarget the build; nothing else should hard-code these.
# ─────────────────────────────────────────────────────────────────────────────

# ── Target OS ────────────────────────────────────────────────────────────────
# Primary target is FreeBSD 2.2.8 (closest redistributable 4.3BSD-lineage cousin
# of the era's SunOS).  If the 2.x install proves a time-sink under current QEMU,
# set BOX_OS_VERSION=4.11 (floppies/dist layout differ; the pipeline handles both)
# and document the switch in docs/historicity.md § OS-version decision.
BOX_OS_VERSION="${BOX_OS_VERSION:-2.2.8}"        # 2.2.8 | 4.11
BOX_ARCH="i386"

# Upstream archive (plain HTTP: the archive's TLS cert SAN does not match its
# hostname; see build/10-fetch-media.sh).  Verified against per-set CHECKSUM.MD5.
BOX_ARCHIVE_BASE="http://ftp-archive.freebsd.org/pub/FreeBSD-Archive/old-releases/i386"

# Distribution sets to install (minimal bootable userland).  'bin' is mandatory.
BOX_DIST_SETS="bin"

# ── Disk / machine ─────────────────────────────────────────────────────────────
BOX_DISK_SIZE="1500M"            # period-plausible; comfortably fits a minimal install
BOX_MEM_MB="128"                 # 2.2.8 is happy in 64–128M; QEMU default machine
BOX_QEMU="qemu-system-i386"
# 'isapc' or default 'pc'?  The default 'pc' (i440FX) works with 2.2.8's wd0 IDE.
BOX_MACHINE="pc"
BOX_CPU="pentium"                # avoid exposing modern CPU features to a '95 kernel

# ── Theming / identity (COSMETIC — see README "banners lie") ───────────────────
BOX_HOSTNAME="gaia"              # cf. gaia.internex.net (sessions 4006/4007/4011)
BOX_DOMAIN="internex.net"
BOX_THEME="sunos414"             # selects build/payloads/theme/<name>

# ── Lab accounts (THROWAWAY lab passwords — no real creds; see PROVENANCE §5) ──
# Foothold account the player lands on first:
BOX_FOOTHOLD_USER="brian"        # cf. 'brian' uid 104 on gaia (sessions 4006/4007)
BOX_FOOTHOLD_PASS="newriver"     # throwaway lab password; hinted via breadcrumb
# The "trusted" account reached over the .rhosts "+ +" r-services trust:
BOX_TRUST_USER="dono"            # cf. 'dono' foothold/toolkit account (4001)
BOX_TRUST_PASS="changeme"        # never used by the path (rsh trust bypasses auth)
# Root password (player should reach root via setuid, not this):
BOX_ROOT_PASS="toor1995"

# ── Win condition ──────────────────────────────────────────────────────────────
BOX_LOOT_NAME="maniac1.3.4.tar.gz"   # echoes the MANIAC firewall source (4014/4017)
BOX_LOOT_DIR="/usr/src/sys/maniac"   # where root finds it on the box
# ── Flag: DERIVED off-box, materialised in RAM at boot ─────────────────────────
# The flag is NEVER stored as static text in this repo, in git history, or as
# plaintext on the disk image.  Design:
#   * SEED (the owner's secret) lives ONLY outside the repo — in $BOX_FLAG_SEED in
#     your shell, or in a git-ignored secret/flag.seed file.  build/flag.sh reads
#     it and computes the deterministic flag:  flag = BU{ hash(seed+instance)_suffix }.
#   * At BUILD time the owner's computed flag is baked into an OBFUSCATED blob on
#     the disk (no literal "BU{...").  At BOOT the box decodes it into a memory
#     filesystem (MFS) — so a powered-off image, mounted offline, has no flag.
#   * The whole qcow2 is additionally LUKS-encrypted at the QEMU layer, so offline
#     qemu-nbd / libguestfs see ciphertext (see build/70-luks.sh, run.sh).
# instance_id is PUBLIC (safe on the image); it lets you mint per-player flags
# without changing the seed.  Rotate by changing the seed or the instance id.
BOX_FLAG_INSTANCE="box1-gaia-0001"          # public per-instance id (part of the hash)
BOX_FLAG_SUFFIX="r5h_setu1d_newgrp_1995"    # cosmetic theme tail kept on every flag
# Decoy left in the PERSISTENT (on-disk) loot so an offline peek hits this, never
# the real flag (which exists only in MFS on a running, solved box):
BOX_FLAG_DECOY="BU{n0t_th3_fl4g__b00t_4nd_pwn_th3_b0x_t0_g3t_1t}"
# NOTE: BOX_FLAG_SEED is intentionally NOT defined here.  Keep it out of the repo.

# ── Host-only networking (REQUIRED — no internet needed to solve) ──────────────
# run.sh enforces this.  Default: QEMU user-mode net restricted to host-only via
# a private guest subnet with no DNS/route to the internet; the attacker host
# reaches the box through host-forwarded ports on 127.0.0.1.  See run.sh + docs.
BOX_NET_MODE="hostonly"
BOX_HOST_SSH_FWD=""              # guest predates SSH — intentionally empty
# Period services reachable from the attacker for the intended path:
BOX_FWD_TELNET="2323"            # host 127.0.0.1:2323 -> guest telnet/23 (login)
BOX_FWD_FTP="2121"               # host 127.0.0.1:2121 -> guest ftp/21 (if used)
BOX_FWD_SHELL="5514"             # host 127.0.0.1:5514 -> guest rlogin/513 area

# ── Paths (relative to repo root) ──────────────────────────────────────────────
BOX_MEDIA_DIR="media/${BOX_OS_VERSION}"
BOX_DIST_DIR="dist"
BOX_WORK_DIR="work"
BOX_IMAGE="dist/box1-${BOX_HOSTNAME}.qcow2"           # plaintext build/working image
BOX_ENC_IMAGE="dist/box1-${BOX_HOSTNAME}.enc.qcow2"   # LUKS-encrypted DISTRIBUTABLE
BOX_SERIAL_SPEED="9600"          # 2.2.8 boot blocks default serial console speed

# ── Disk-at-rest encryption (LUKS, at the QEMU layer — 2.2.8 can't do it guest-side)
# build/70-luks.sh wraps the plaintext image into BOX_ENC_IMAGE; run.sh boots the
# encrypted image, reading the key from $BOX_LUKS_KEY or this git-ignored keyfile.
# The key MUST NOT live inside the image; ship it as a separate file with the VM.
BOX_LUKS_KEYFILE="secret/luks.key"
