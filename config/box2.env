# ─────────────────────────────────────────────────────────────────────────────
# Box 2 "The Traced Call" build parameters.  Same shape as config/box.env.
# Box 2 REUSES Box 1's installed+costumed base image (no fresh OS install) and
# applies a Box-2 inject (foothold trace + root vector + watcher + toolkit).
# ─────────────────────────────────────────────────────────────────────────────

# ── Target OS / machine (inherited from the Box 1 base image) ──────────────────
BOX_OS_VERSION="${BOX_OS_VERSION:-2.2.8}"
BOX_ARCH="i386"
BOX_DISK_SIZE="1500M"
BOX_MEM_MB="128"
BOX_QEMU="qemu-system-i386"
BOX_MACHINE="pc"
BOX_CPU="pentium"
BOX_SERIAL_SPEED="9600"

# ── Base image to clone (the PROVEN Box 1 installed + SunOS-costumed disk) ──────
# 40-inject2.sh copies this to BOX_IMAGE, then plants the Box-2 payload.
BOX2_BASE_IMAGE="dist/box1-gaia.built.qcow2"

# ── Theming / identity ─────────────────────────────────────────────────────────
# teal.csn.org — a CSN host (cf 4001 banner) and the site of the literal
# "scrub reboot logs — the traced call" episode (4015/4016).
BOX_HOSTNAME="teal"
BOX_DOMAIN="csn.org"
BOX_THEME="sunos414"             # reuse the Box 1 SunOS costume

# ── Lab accounts (THROWAWAY lab passwords — no real creds) ─────────────────────
# Continuity: you are 'brian', pivoting in FROM gaia (Box 1).  brian's session is
# the trace the watcher hunts and you must erase.
BOX_FOOTHOLD_USER="brian"        # the intruder persona carried over from gaia
BOX_FOOTHOLD_PASS="newriver"     # throwaway lab password (handed off from Box 1 lore)
BOX_INTRUDER_SRCHOST="gaia"      # planted source host in the records (extra signature)
# Root vector for Box 2 (distinct from Box 1's newgrp): see docs/box2-design.md
# open-question #1 — default to a trojaned /bin/login (blank login -> root, cf 4015).
BOX_ROOT_VECTOR="trojan-login"   # trojan-login | port3111
BOX_LOGIN_MAGIC="wank"           # magic username at the trojaned login -> root (cf 4007)
BOX_ROOT_PASS="toor1995"

# ── Win condition: the condition-gated trophy ──────────────────────────────────
BOX_LOOT_NAME="trophy.txt"
BOX_LOOT_DIR="/var/account/.trophy"   # MFS overlay mount point (real) / decoy serve dir
BOX_ACCT_LOG="/var/account/awtmp"     # the host accounting/billing log to scrub
BOX_WATCH_INTERVAL="20"               # tripwire sweep cadence (seconds)

# ── Flag: DERIVED off-box, materialised in RAM only when the logs are clean ────
# Same scheme as Box 1 (build/flag.sh: BU{ hash(seed+instance)_suffix }); SEED
# stays owner-side, never in the image/repo/history.  Decoy MUST match tripwire.sh.
BOX_FLAG_INSTANCE="box2-teal-0001"
BOX_FLAG_SUFFIX="cov3r_y0ur_tr4cks_1995"
BOX_FLAG_DECOY="BU{th3_c4ll_w4s_tr4c3d__scrub_wtmp_utmp_lastlog_and_th3_4cct_l0gs}"
# NOTE: BOX_FLAG_SEED intentionally NOT defined here (shared secret/flag.seed).

# ── Host-only networking (REQUIRED) ────────────────────────────────────────────
BOX_NET_MODE="hostonly"
BOX_HOST_SSH_FWD=""
BOX_FWD_TELNET="2323"
BOX_FWD_FTP="2121"
BOX_FWD_SHELL="5514"

# ── Paths ──────────────────────────────────────────────────────────────────────
BOX_MEDIA_DIR="media/${BOX_OS_VERSION}"
BOX_DIST_DIR="dist"
BOX_WORK_DIR="work"
BOX_IMAGE="dist/box2-${BOX_HOSTNAME}.qcow2"
BOX_ENC_IMAGE="dist/box2-${BOX_HOSTNAME}.enc.qcow2"
BOX_LUKS_KEYFILE="secret/luks.key"
