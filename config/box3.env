# ─────────────────────────────────────────────────────────────────────────────
# Box 3 build parameters.  Same shape as config/box.env; clones the Box 1
# installed+costumed base and applies a Box-3 inject (no fresh OS install).
# Fill in every TODO, then: build/40-inject3.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Target OS / machine (inherited from the Box 1 base image) ──────────────────
BOX_OS_VERSION="${BOX_OS_VERSION:-2.2.8}"
BOX_ARCH="i386"
BOX_DISK_SIZE="1500M"
BOX_MEM_MB="128"
BOX_QEMU="qemu-system-i386"
BOX_MACHINE="pc"
BOX_CPU="pentium"
BOX_SERIAL_SPEED="9600"

# ── Base image to clone (the PROVEN Box 1 installed + SunOS-costumed disk) ──────
BOX3_BASE_IMAGE="dist/box1-gaia.built.qcow2"

# ── Theming / identity ─────────────────────────────────────────────────────────
BOX_HOSTNAME="escape"            # escape.com — a real shell provider Mitnick used (4005/4023)
BOX_DOMAIN="com"
BOX_THEME="sunos414"             # reuse the Box 1 SunOS costume

# ── Lab accounts (THROWAWAY lab passwords — no real creds) ─────────────────────
BOX_FOOTHOLD_USER="brian"        # the intruder persona (carried across boxes)
BOX_FOOTHOLD_PASS="newriver"
BOX_TRUST_USER="dono"            # kept from the base — hosts the prior-intruder cache
# The operator whose cleartext credential the prior intruder's sniffer captured.
# ops is in group wheel, and root REUSES ops's password — the two Box 3 lessons.
BOX_OPS_USER="ops"
BOX_OPS_PASS="c0nvex.7"          # captured in the sunsniffer log; reused by root
BOX_ROOT_PASS="c0nvex.7"         # password REUSE (== BOX_OPS_PASS)
BOX_SNIFFLOG="/home/dono/.sunsniff.log"   # the intruder's found capture log

# ── Win condition ──────────────────────────────────────────────────────────────
BOX_LOOT_NAME="flag.txt"
BOX_LOOT_DIR="/var/adm/.loot"    # root-only; gen-flag MFS overlay materialises the flag here

# ── Flag: DERIVED off-box, materialised in RAM (never static on disk) ──────────
# Same scheme as Box 1 (build/flag.sh: BU{ hash(seed+instance)_suffix }); SEED
# stays owner-side.  Decoy MUST match what the inject writes to the on-disk loot.
BOX_FLAG_INSTANCE="box3-escape-0001"
BOX_FLAG_SUFFIX="sn1ff3d_cr3ds_r3us3d_1995"
BOX_FLAG_DECOY="BU{n0_fl4g_0n_d1sk__sn1ff_th3_4dm1n_4nd_r3us3_t0_r00t}"
# NOTE: BOX_FLAG_SEED intentionally NOT defined (shared secret/flag.seed).

# ── Host-only networking (REQUIRED) ────────────────────────────────────────────
BOX_NET_MODE="hostonly"
BOX_HOST_SSH_FWD=""
BOX_FWD_TELNET="2323"
BOX_FWD_FTP="2121"
BOX_FWD_SHELL="5514"

# ── Paths ──────────────────────────────────────────────────────────────────────
BOX_MEDIA_DIR="media/${BOX_OS_VERSION}"
BOX_DIST_DIR="dist"
BOX_WORK_DIR="work"
BOX_IMAGE="dist/box3-${BOX_HOSTNAME}.qcow2"
BOX_ENC_IMAGE="dist/box3-${BOX_HOSTNAME}.enc.qcow2"
BOX_LUKS_KEYFILE="secret/luks.key"
