# ── Large build artifacts (never committed; reproduced by the pipeline) ──
# Disk images, install media, CD images, appliance bundles
*.qcow2
*.qcow
*.raw
*.img
*.iso
*.ova
*.vmdk
*.vdi
# Floppy / distribution media and the built-CD staging tree
/media/
/dist/
/work/

# Loot tarball is generated by the build (contains the flag) — never commit it
build/payloads/loot/*.tar.gz
build/payloads/loot/*.tar.Z

# ── Python / tooling ──
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# ── Editor / OS cruft ──
.claude/
.DS_Store
*.swp
*~

# ── Secrets — MUST never be committed (flag seed, LUKS key) ──
/secret/
*.seed
*.key
*.keyfile
flag.seed
luks.key

# ── Build logs / scratch ──
*.log
!docs/**/*.log
