# ─────────────────────────────────────────────────────────────────────────────
# Box @@N@@ build parameters.  Same shape as config/box.env; clones the Box 1
# installed+costumed base and applies a Box-@@N@@ inject (no fresh OS install).
# Fill in every TODO, then: build/40-inject@@N@@.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Target OS / machine (inherited from the Box 1 base image) ──────────────────
BOX_OS_VERSION="${BOX_OS_VERSION:-2.2.8}"
BOX_ARCH="i386"
BOX_DISK_SIZE="1500M"
BOX_MEM_MB="128"
BOX_QEMU="qemu-system-i386"
BOX_MACHINE="pc"
BOX_CPU="pentium"
BOX_SERIAL_SPEED="9600"

# ── Base image to clone (the PROVEN Box 1 installed + SunOS-costumed disk) ──────
BOX@@N@@_BASE_IMAGE="dist/box1-gaia.built.qcow2"

# ── Theming / identity ─────────────────────────────────────────────────────────
BOX_HOSTNAME="@@HOST@@"          # TODO: a host grounded in ~/takedown/TIMELINE.md
BOX_DOMAIN="@@DOMAIN@@"
BOX_THEME="sunos414"             # reuse the Box 1 SunOS costume

# ── Lab accounts (THROWAWAY lab passwords — no real creds) ─────────────────────
BOX_FOOTHOLD_USER="brian"        # the intruder persona (carried across boxes)
BOX_FOOTHOLD_PASS="newriver"
BOX_TRUST_USER="dono"            # kept from the base (e.g. toolkit-cache home)
BOX_ROOT_PASS="toor1995"
# TODO: add any vuln-specific knobs (magic words, ports, watch intervals, paths)

# ── Win condition ──────────────────────────────────────────────────────────────
BOX_LOOT_NAME="trophy.txt"
BOX_LOOT_DIR="/var/account/.trophy"   # TODO: where the flag is served / MFS overlay
# TODO: any gating paths your inject/solve need

# ── Flag: DERIVED off-box, materialised in RAM (never static on disk) ──────────
# Same scheme as Box 1 (build/flag.sh: BU{ hash(seed+instance)_suffix }); SEED
# stays owner-side.  Decoy MUST match whatever your gating script serves.
BOX_FLAG_INSTANCE="box@@N@@-@@HOST@@-0001"
BOX_FLAG_SUFFIX="TODO_theme_tail_1995"
BOX_FLAG_DECOY="BU{TODO_decoy_text}"
# NOTE: BOX_FLAG_SEED intentionally NOT defined (shared secret/flag.seed).

# ── Host-only networking (REQUIRED) ────────────────────────────────────────────
BOX_NET_MODE="hostonly"
BOX_HOST_SSH_FWD=""
BOX_FWD_TELNET="2323"
BOX_FWD_FTP="2121"
BOX_FWD_SHELL="5514"

# ── Paths ──────────────────────────────────────────────────────────────────────
BOX_MEDIA_DIR="media/${BOX_OS_VERSION}"
BOX_DIST_DIR="dist"
BOX_WORK_DIR="work"
BOX_IMAGE="dist/box@@N@@-${BOX_HOSTNAME}.qcow2"
BOX_ENC_IMAGE="dist/box@@N@@-${BOX_HOSTNAME}.enc.qcow2"
BOX_LUKS_KEYFILE="secret/luks.key"
